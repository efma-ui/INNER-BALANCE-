<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Inner Refuge | A Space to Find Your Calm</title>

<meta name="description" content="Inner Refuge: an interactive wellness mini-app and a 21-day guided program to understand your thoughts, manage your emotions, and create moments of calm.">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">

<style>

:root {
    --bg: #F8F5F0;
    --cream: #F0EAE1;
    --white: #FFFFFF;
    --sage: #9EAD9A;
    --sage-dark: #657B6A;
    --sage-light: #E5EBE2;
    --brown: #51483F;
    --text: #48443F;
    --muted: #827B73;
    --gold: #C6A77A;
    --dark: #35463C;
    --border: #E7E0D7;
    --shadow: 0 15px 45px rgba(65, 70, 60, .08);
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: 'DM Sans', sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.7;
    overflow-x: hidden;
}

h1, h2, h3 {
    font-family: 'Playfair Display', serif;
    line-height: 1.2;
    color: var(--brown);
}

p {
    color: var(--muted);
}

a {
    text-decoration: none;
    color: inherit;
}

.container {
    width: min(1100px, 90%);
    margin: auto;
}

section {
    padding: 85px 0;
}

.section-label {
    color: var(--sage-dark);
    text-transform: uppercase;
    letter-spacing: 3px;
    font-size: 11px;
    font-weight: 800;
    margin-bottom: 17px;
}

.section-title {
    font-size: clamp(30px, 5vw, 46px);
    margin-bottom: 20px;
}

.section-description {
    max-width: 650px;
    margin: auto;
    font-size: 16px;
}

.center {
    text-align: center;
}

/* BUTTONS */

.btn {
    display: inline-block;
    padding: 17px 30px;
    border-radius: 50px;
    background: var(--sage-dark);
    color: white;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: .5px;
    text-align: center;
    transition: .3s;
    border: none;
    cursor: pointer;
    box-shadow: 0 8px 20px rgba(75, 105, 82, .17);
}

.btn:hover {
    background: var(--dark);
    transform: translateY(-3px);
    box-shadow: 0 12px 25px rgba(75, 105, 82, .22);
}

.btn-outline {
    background: transparent;
    border: 1px solid var(--sage-dark);
    color: var(--sage-dark);
    box-shadow: none;
}

.btn-outline:hover {
    color: white;
}

/* NAVBAR */

.navbar {
    padding: 19px 0;
    background: rgba(248,245,240,.94);
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
}

.nav-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    font-family: 'Playfair Display', serif;
    font-size: 24px;
    color: var(--dark);
    font-weight: 600;
    letter-spacing: .3px;
}

.logo span {
    display: block;
    font-family: 'DM Sans', sans-serif;
    font-size: 9px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--muted);
    text-align: center;
}

/* HERO */

.hero {
    padding: 85px 0 95px;
    background:
        radial-gradient(circle at 80% 20%, #E5EBDD 0%, transparent 35%),
        linear-gradient(135deg, #F8F5F0, #F1EEE7);
}

.hero-grid {
    display: grid;
    grid-template-columns: 1.1fr .9fr;
    align-items: center;
    gap: 60px;
}

.hero h1 {
    font-size: clamp(40px, 6vw, 65px);
    margin-bottom: 25px;
}

.hero h1 span {
    color: var(--sage-dark);
}

.hero-subtitle {
    font-size: 17px;
    line-height: 1.8;
    max-width: 540px;
    margin-bottom: 30px;
}

.hero-tag {
    display: inline-block;
    background: var(--sage-light);
    color: var(--sage-dark);
    padding: 8px 15px;
    border-radius: 30px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
    margin-bottom: 25px;
}

.hero-note {
    font-size: 12px;
    margin-top: 15px;
}

.hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 410px;
}

.hero-circle {
    width: 320px;
    height: 320px;
    border-radius: 50%;
    background: linear-gradient(145deg, #E8EDE4, #CFDCCB);
    display: flex;
    justify-content: center;
    align-items: center;
    box-shadow: 0 25px 70px rgba(75, 105, 82, .14);
    position: relative;
}

.hero-circle::before {
    content: "";
    position: absolute;
    width: 255px;
    height: 255px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,.8);
}

.hero-circle-content {
    text-align: center;
    z-index: 2;
}

.hero-symbol {
    font-size: 75px;
    color: var(--sage-dark);
    line-height: 1;
    margin-bottom: 15px;
}

.hero-circle-content h3 {
    font-size: 27px;
}

.hero-circle-content p {
    font-size: 11px;
    letter-spacing: 3px;
    margin-top: 8px;
}

.floating-card {
    position: absolute;
    background: white;
    padding: 15px 20px;
    border-radius: 16px;
    box-shadow: var(--shadow);
    font-size: 12px;
    color: var(--brown);
}

.card-one {
    top: 30px;
    right: 0;
}

.card-two {
    bottom: 35px;
    left: 0;
}

/* POWER FEATURES */

.power-section {
    background: white;
}

.power-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-top: 45px;
}

.power-card {
    padding: 25px;
    background: var(--bg);
    border-radius: 17px;
    display: flex;
    gap: 17px;
    align-items: flex-start;
    border: 1px solid var(--border);
    transition: .3s;
}

.power-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
}

.power-icon {
    width: 42px;
    height: 42px;
    min-width: 42px;
    background: var(--sage-light);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--sage-dark);
    font-size: 19px;
}

.power-card h3 {
    font-family: 'DM Sans', sans-serif;
    font-size: 15px;
    margin-bottom: 6px;
}

.power-card p {
    font-size: 13px;
}

/* PRICE */

.price-section {
    background: var(--dark);
    color: white;
    text-align: center;
    padding: 75px 0;
}

.price-section h2 {
    color: white;
    font-size: 38px;
}

.price-section p {
    color: #E0E7DF;
    margin: 15px auto 25px;
    max-width: 550px;
}

.old-price {
    text-decoration: line-through;
    opacity: .65;
}

.new-price {
    font-family: 'Playfair Display', serif;
    font-size: 65px;
    color: #E4D0AC;
    font-weight: 700;
    margin: 8px 0;
}

.price-section .btn {
    background: #D6C19E;
    color: var(--dark);
}

.price-section .btn:hover {
    background: white;
}

/* CTA */

.cta-inline {
    text-align: center;
    padding: 45px 15px;
}

/* QUALIFICATION */

.qualification {
    background: var(--cream);
}

.check-list {
    max-width: 720px;
    margin: 35px auto;
    display: grid;
    gap: 16px;
}

.check-item {
    display: flex;
    align-items: center;
    gap: 15px;
    background: white;
    padding: 19px 22px;
    border-radius: 13px;
    box-shadow: 0 5px 20px rgba(0,0,0,.025);
}

.check {
    color: var(--sage-dark);
    font-size: 20px;
    font-weight: 800;
}

.qualification-note {
    text-align: center;
    color: var(--sage-dark);
    font-weight: 700;
}

/* PROBLEM */

.problem {
    background: white;
}

.problem-box {
    max-width: 800px;
    margin: 35px auto 0;
    padding: 40px;
    background: var(--bg);
    border-radius: 20px;
    border-left: 4px solid var(--sage);
}

.problem-box p {
    margin-bottom: 17px;
    font-size: 15px;
}

.problem-box p:last-child {
    margin-bottom: 0;
}

/* SOLUTION */

.solution {
    background: var(--sage-light);
}

.solution-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 45px;
    align-items: center;
}

.solution-card {
    background: white;
    border-radius: 20px;
    padding: 35px;
    box-shadow: var(--shadow);
}

.solution-card h3 {
    font-size: 22px;
    margin-bottom: 20px;
}

.solution-step {
    padding: 17px 0;
    border-bottom: 1px solid var(--border);
}

.solution-step:last-child {
    border: none;
}

.solution-step strong {
    display: block;
    color: var(--sage-dark);
    margin-bottom: 5px;
}

.solution-step p {
    font-size: 13px;
}

/* METHOD */

.method {
    background: white;
}

.method-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
    margin-top: 45px;
}

.method-card {
    padding: 30px 25px;
    background: var(--bg);
    border-radius: 18px;
    border-top: 3px solid var(--sage);
}

.method-number {
    font-family: 'Playfair Display', serif;
    font-size: 40px;
    color: var(--sage);
    margin-bottom: 12px;
}

.method-card h3 {
    font-family: 'DM Sans', sans-serif;
    font-size: 16px;
    margin-bottom: 12px;
}

.method-card p {
    font-size: 13px;
}

/* URGENCY */

.urgency {
    background: var(--cream);
    text-align: center;
}

.urgency h2 {
    max-width: 700px;
    margin: auto;
}

.urgency-text {
    max-width: 650px;
    margin: 25px auto;
}

.urgency-text p {
    margin-bottom: 12px;
}

/* BONUSES */

.bonuses {
    background: white;
}

.bonus-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 25px;
    margin-top: 45px;
}

.bonus-card {
    padding: 30px;
    background: var(--bg);
    border-radius: 18px;
    border: 1px solid var(--border);
    position: relative;
    transition: .3s;
}

.bonus-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow);
}

.bonus-label {
    color: var(--sage-dark);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 2px;
    margin-bottom: 12px;
}

.bonus-card h3 {
    font-size: 24px;
    margin-bottom: 12px;
}

.bonus-card strong {
    display: block;
    color: var(--brown);
    font-size: 14px;
    margin-bottom: 12px;
}

.bonus-card p {
    font-size: 13px;
}

/* TESTIMONIALS */

.testimonials {
    background: var(--sage-light);
}

.testimonial-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 40px;
}

.testimonial {
    background: white;
    border-radius: 18px;
    padding: 25px;
}

.testimonial small {
    color: var(--sage-dark);
    font-weight: 800;
    font-size: 10px;
    letter-spacing: 1px;
}

.testimonial p {
    font-size: 14px;
    margin: 15px 0;
    color: var(--brown);
    font-style: italic;
}

.testimonial strong {
    font-size: 12px;
}

/* ACCESS */

.access {
    background: white;
}

.access-box {
    max-width: 700px;
    margin: 40px auto;
    background: var(--bg);
    border-radius: 20px;
    padding: 35px;
    border: 1px solid var(--border);
}

.access-row {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    padding: 15px 0;
    border-bottom: 1px solid var(--border);
    font-size: 14px;
}

.access-row:last-of-type {
    border: none;
}

.access-row span:last-child {
    font-weight: 700;
    color: var(--sage-dark);
}

.access-total {
    margin-top: 20px;
    padding-top: 20px;
    border-top: 2px solid var(--sage);
}

.access-total .total {
    font-size: 19px;
    font-weight: 800;
    color: var(--brown);
}

.savings {
    text-align: center;
    margin-top: 30px;
    color: var(--sage-dark);
    font-weight: 800;
}

.final-price {
    text-align: center;
    font-family: 'Playfair Display', serif;
    font-size: 48px;
    color: var(--dark);
    margin: 10px 0 25px;
}

/* GUARANTEE */

.guarantee {
    background: var(--cream);
}

.guarantee-card {
    max-width: 760px;
    margin: auto;
    text-align: center;
    padding: 45px;
    background: white;
    border-radius: 22px;
    box-shadow: var(--shadow);
}

.guarantee-icon {
    font-size: 48px;
    margin-bottom: 15px;
}

.guarantee-card p {
    margin-top: 15px;
}

/* FAQ */

.faq {
    background: white;
}

.faq-container {
    max-width: 800px;
    margin: 40px auto 0;
}

details {
    border-bottom: 1px solid var(--border);
    padding: 20px 5px;
}

summary {
    cursor: pointer;
    font-weight: 700;
    color: var(--brown);
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 15px;
}

summary::after {
    content: "+";
    color: var(--sage-dark);
    font-size: 20px;
}

details[open] summary::after {
    content: "−";
}

details p {
    margin-top: 15px;
    font-size: 14px;
    max-width: 700px;
}

/* FINAL */

.final-section {
    background:
        radial-gradient(circle at 50% 0%, #637968, transparent 65%),
        var(--dark);
    padding: 100px 0;
    text-align: center;
}

.final-section h2 {
    color: white;
    font-size: clamp(34px, 5vw, 49px);
    max-width: 750px;
    margin: auto;
}

.final-section p {
    color: #E5EAE3;
    margin: 25px auto;
    max-width: 600px;
}

.final-section .btn {
    background: #D6C19E;
    color: var(--dark);
}

.final-section .btn:hover {
    background: white;
}

/* FOOTER */

footer {
    background: #29382F;
    text-align: center;
    padding: 35px 15px;
}

footer p {
    font-size: 11px;
    color: #C5CEC5;
    margin: 6px;
}

footer a {
    color: #E5D4B5;
}

/* ANIMATIONS */

.fade-up {
    animation: fadeUp .8s ease both;
}

@keyframes fadeUp {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* RESPONSIVE */

@media(max-width: 800px) {

    section {
        padding: 65px 0;
    }

    .hero {
        padding: 60px 0;
    }

    .hero-grid,
    .solution-grid {
        grid-template-columns: 1fr;
        gap: 35px;
    }

    .hero h1 {
        font-size: 43px;
    }

    .hero-visual {
        min-height: 350px;
    }

    .hero-circle {
        width: 270px;
        height: 270px;
    }

    .hero-circle::before {
        width: 220px;
        height: 220px;
    }

    .floating-card {
        font-size: 10px;
    }

    .power-grid,
    .bonus-grid {
        grid-template-columns: 1fr;
    }

    .method-grid {
        grid-template-columns: 1fr;
    }

    .testimonial-grid {
        grid-template-columns: 1fr;
    }

    .price-section h2 {
        font-size: 31px;
    }

    .access-box {
        padding: 22px;
    }

    .guarantee-card {
        padding: 30px 22px;
    }

    .nav-inner .btn {
        padding: 12px 17px;
        font-size: 10px;
    }

    .logo {
        font-size: 20px;
    }

}

@media(max-width: 380px) {

    .hero h1 {
        font-size: 36px;
    }

    .new-price {
        font-size: 55px;
    }

    .floating-card {
        padding: 10px;
    }

}

</style>
</head>

